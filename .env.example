# CatalogFlow defaults: CPU extraction and local CPU vision review.
# Copy to .env. Local review needs no ChatGPT login or Platform API key.
COMPOSE_PROFILES=
TZ=Asia/Yekaterinburg
LOCAL_UID=1000
LOCAL_GID=1000

# Optional read-only source folder; WSL example:
# GUHRING_CATALOG_DIR=/mnt/c/Users/senka/Desktop/Каталоги/GUHRING
GUHRING_CATALOG_DIR=

MINERU_VERSION=3.4.5
MINERU_MODEL_SOURCE=huggingface
MINERU_API_PORT=8000
MINERU_UPSTREAM_TIMEOUT=7200
MINERU_API_TASK_RETENTION_SECONDS=3600
MINERU_SHM_SIZE=4gb
PIPELINE_UI_BIND=127.0.0.1
PIPELINE_UI_PORT=7861
PIPELINE_UI_MAX_UPLOAD_MB=512
OLLAMA_VERSION=0.32.5
OLLAMA_PORT=11434
OLLAMA_DATA_DIR=./data/ollama

# Older optional integrations use docker-compose.legacy.yml and
# .env.legacy.example; those services are not part of the default pipeline.
