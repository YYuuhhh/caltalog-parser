# Optional legacy RAGFlow/GPU/Platform-API configuration. Not required by CatalogFlow.
COMPOSE_PROFILES=
TZ=Asia/Yekaterinburg

RAGFLOW_IMAGE=infiniflow/ragflow:v0.27.0
RAGFLOW_UI_PORT=8080
RAGFLOW_API_PORT=9380
RAGFLOW_DATASET=Tool Catalogs (MinerU)
# Optional read-only retrieval used by `make audit`.
RAGFLOW_API_KEY=
RAGFLOW_ADMIN_NICKNAME=guhring-admin
RAGFLOW_ADMIN_EMAIL=admin@guhring.local
RAGFLOW_ADMIN_PASSWORD=change-me-local

ELASTIC_PASSWORD=guhring_es_local
MYSQL_PASSWORD=guhring_mysql_local
MYSQL_DBNAME=rag_flow
MINIO_USER=rag_flow
MINIO_PASSWORD=guhring_minio_local
MINIO_CONSOLE_PORT=9001
REDIS_PASSWORD=guhring_redis_local

TEI_MODEL=BAAI/bge-small-en-v1.5
# Optional multilingual profile: set TEI_MODEL=BAAI/bge-m3 and use
# docker-compose.multilingual.yml; create a fresh RAGFlow dataset.
ES_JAVA_OPTS=-Xms2g -Xmx2g
ES_MEMORY_LIMIT=3g

MINERU_VERSION=3.4.5
MINERU_MODEL_SOURCE=huggingface
MINERU_MODEL_REVISION=mineru-3.4.5-pipeline
MINERU_GPU_MODEL_REVISION=mineru-3.4.5-vlm-2605
MINERU_BACKEND=pipeline
MINERU_API_PORT=8000
MINERU_UI_PORT=7860
PIPELINE_UI_PORT=7861
PIPELINE_UI_MAX_UPLOAD_MB=512
MINERU_UPSTREAM_TIMEOUT=7200
MINERU_API_TASK_RETENTION_SECONDS=3600
MINERU_SHM_SIZE=4gb

# Optional cloud post-processing. The local RAGFlow + MinerU stack does not
# require this key; API calls require an explicit OpenAI make target or live
# processing through an explicitly chosen legacy CLI command.
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-sol
# Optional second model; only conflicting row reviews are escalated.
OPENAI_ESCALATION_MODEL=
OPENAI_REASONING_EFFORT=medium
OPENAI_BATCH_ROWS=50
OPENAI_TIMEOUT_SECONDS=600
OPENAI_MAX_RETRIES=4
OPENAI_VALIDATION_RETRIES=2
OPENAI_MAX_OUTPUT_TOKENS=32000
OPENAI_INCLUDE_SOURCE_PAGE=true
OPENAI_SELECTION_MANIFEST=/catalogs/manifests/guhring-production.yaml
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=

# Match the host account for files created by one-shot helper containers.
LOCAL_UID=1000
LOCAL_GID=1000
