{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guhring.local/schemas/field-mapping.schema.json",
  "title": "Versioned manufacturer field mapping",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mapping_schema_version",
    "mapping_profile",
    "mapping_version",
    "manufacturer",
    "series",
    "families",
    "rules",
    "matcher_contract"
  ],
  "properties": {
    "mapping_schema_version": {
      "const": "1.0"
    },
    "mapping_profile": {
      "type": "string",
      "minLength": 1
    },
    "mapping_version": {
      "type": "string",
      "minLength": 1
    },
    "manufacturer": {
      "type": "string",
      "minLength": 1
    },
    "series": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/series"
      }
    },
    "families": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/family"
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "matcher_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "status",
        "wide_fields"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "provisional",
            "approved"
          ]
        },
        "wide_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "identifiers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pattern"
        ],
        "properties": {
          "pattern": {
            "type": "string",
            "minLength": 1
          },
          "article_number": {
            "type": "string"
          },
          "raw_headers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "relation_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "families",
          "raw_headers",
          "relation_type"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "families": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "raw_headers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "relation_type": {
            "enum": [
              "consists_of",
              "compatible_with",
              "uses_insert",
              "uses_cartridge",
              "uses_holder",
              "replacement_for",
              "supersedes"
            ]
          },
          "separator": {
            "type": "string"
          },
          "review_required": {
            "type": "boolean"
          }
        }
      }
    },
    "context_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "families",
          "canonical_field",
          "data_type",
          "criticality",
          "series",
          "pattern"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
          },
          "families": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "series": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "raw_headers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "canonical_field": {
            "type": "string",
            "minLength": 1
          },
          "data_type": {
            "enum": [
              "string",
              "identifier",
              "decimal",
              "integer",
              "range",
              "boolean",
              "enum"
            ]
          },
          "source_unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "canonical_unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "transform": {
            "enum": [
              "identity",
              "decimal_comma",
              "integer",
              "decimal_range"
            ]
          },
          "criticality": {
            "enum": [
              "hard",
              "soft",
              "informational"
            ]
          },
          "review_required": {
            "type": "boolean"
          },
          "matcher_column": {
            "type": [
              "string",
              "null"
            ]
          },
          "raw_header_paths": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          },
          "minimum": {
            "type": "string"
          },
          "maximum": {
            "type": "string"
          },
          "allowed_values": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "pattern": {
            "type": "string",
            "minLength": 1
          },
          "allow_fit": {
            "type": "boolean"
          }
        }
      }
    },
    "symbol_dictionary": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "symbol",
          "canonical_field",
          "description",
          "unit",
          "family",
          "series",
          "data_type",
          "evidence",
          "source_url",
          "source_page",
          "status"
        ],
        "properties": {
          "symbol": {
            "type": "string"
          },
          "canonical_field": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "family": {
            "type": "string"
          },
          "data_type": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "source_url": {
            "type": "string"
          },
          "source_page": {
            "type": "string"
          },
          "series": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "proposed",
              "verified",
              "rejected"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "series": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "article_number",
        "family",
        "item_type"
      ],
      "properties": {
        "article_number": {
          "type": "string",
          "minLength": 1
        },
        "family": {
          "type": "string",
          "minLength": 1
        },
        "subfamily": {
          "type": [
            "string",
            "null"
          ]
        },
        "item_type": {
          "enum": [
            "sku",
            "size_variant",
            "kit",
            "component",
            "accessory"
          ]
        },
        "series_name": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "required_fields"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "required_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "families",
        "raw_headers",
        "canonical_field",
        "data_type",
        "criticality"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
        },
        "families": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "series": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "raw_headers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "canonical_field": {
          "type": "string",
          "minLength": 1
        },
        "data_type": {
          "enum": [
            "string",
            "identifier",
            "decimal",
            "integer",
            "range",
            "boolean",
            "enum"
          ]
        },
        "source_unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "canonical_unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "transform": {
          "enum": [
            "identity",
            "decimal_comma",
            "integer",
            "decimal_range"
          ]
        },
        "criticality": {
          "enum": [
            "hard",
            "soft",
            "informational"
          ]
        },
        "review_required": {
          "type": "boolean"
        },
        "matcher_column": {
          "type": [
            "string",
            "null"
          ]
        },
        "raw_header_paths": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        },
        "minimum": {
          "type": "string"
        },
        "maximum": {
          "type": "string"
        },
        "allowed_values": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "allow_fit": {
          "type": "boolean"
        }
      }
    }
  }
}
