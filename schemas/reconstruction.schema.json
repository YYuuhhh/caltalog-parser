{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewed table reconstruction without changing MinerU RAW",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "reconstruction_id", "source_sha256", "page_idx", "cache_key", "table_index", "replace_rows", "rows", "status", "reviewer", "reason", "evidence", "decided_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "reconstruction_id": {"type": "string", "minLength": 1},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "page_idx": {"type": "integer", "minimum": 0},
    "cache_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "table_index": {"type": "integer", "minimum": 0},
    "replace_rows": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
    "article_number": {"type": "string", "minLength": 1},
    "proposal_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^missing_[0-9a-f]{32}$"}},
    "status": {"enum": ["draft", "accepted", "rejected"]},
    "reviewer": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "evidence": {"type": "string", "minLength": 1},
    "decided_at": {"type": "string", "format": "date-time"},
    "rows": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["bbox", "cells"],
        "properties": {
          "bbox": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": 0, "maximum": 1000}},
          "cells": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["column_index", "header_path", "value"],
              "properties": {
                "column_index": {"type": "integer", "minimum": 0},
                "header_path": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
                "value": {"type": ["string", "null"]}
              }
            }
          }
        }
      }
    }
  }
}
