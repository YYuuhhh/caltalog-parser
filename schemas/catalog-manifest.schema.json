{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guhring.local/schemas/catalog-manifest.schema.json",
  "title": "Catalog import manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_id",
    "manufacturer",
    "catalog_role",
    "revision",
    "languages",
    "documents",
    "mapping_profile",
    "tool_families",
    "status",
    "review_policy",
    "matcher_contract"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "catalog_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "manufacturer": {
      "type": "string",
      "minLength": 1
    },
    "catalog_role": {
      "enum": [
        "UNASSIGNED",
        "SOURCE",
        "TARGET"
      ]
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "publication_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z]{2,3}$"
      }
    },
    "mapping_profile": {
      "type": "string",
      "minLength": 1
    },
    "tool_families": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "enum": [
        "draft",
        "reviewed",
        "published",
        "registered",
        "parsing",
        "parsed"
      ]
    },
    "review_policy": {
      "enum": [
        "optional",
        "required_for_publish"
      ]
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/document"
      }
    },
    "parse_selection": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/parse_selection"
      }
    },
    "golden_expectations": {
      "$ref": "#/$defs/golden_expectations"
    },
    "matcher_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "status"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "provisional",
            "approved"
          ]
        }
      }
    },
    "publication_blockers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "require_page_completeness": {
      "type": "boolean"
    },
    "input_root": {
      "type": "string"
    },
    "page_states": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_sha256",
          "page_idx",
          "status"
        ],
        "properties": {
          "source_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "page_idx": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "enum": [
              "registered",
              "processing",
              "parsed",
              "empty",
              "failed"
            ]
          },
          "cache_key": {
            "$ref": "#/$defs/sha256"
          },
          "artifact_path": {
            "type": "string"
          },
          "artifact_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "reason": {
            "type": "string"
          },
          "reviewer": {
            "type": "string"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "published"
          }
        }
      },
      "then": {
        "properties": {
          "catalog_role": {
            "enum": [
              "SOURCE",
              "TARGET"
            ]
          },
          "matcher_contract": {
            "properties": {
              "status": {
                "const": "approved"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "file",
        "sha256",
        "pages"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "pages": {
          "type": "integer",
          "minimum": 1
        },
        "source_pages": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "original_source_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "parse_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_sha256",
        "page_idx",
        "cache_key"
      ],
      "properties": {
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "page_idx": {
          "type": "integer",
          "minimum": 0
        },
        "cache_key": {
          "$ref": "#/$defs/sha256"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "golden_expectations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "total_expected",
        "pages"
      ],
      "properties": {
        "metric": {
          "const": "source_product_rows"
        },
        "total_expected": {
          "type": "integer",
          "minimum": 0
        },
        "pages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/golden_page_expectation"
          }
        }
      }
    },
    "golden_page_expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_products",
        "known_missing_order_numbers"
      ],
      "properties": {
        "source_page": {
          "type": "integer",
          "minimum": 1
        },
        "expected_products": {
          "type": "integer",
          "minimum": 0
        },
        "known_missing_order_numbers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "page_idx": {
          "type": "integer",
          "minimum": 0
        }
      },
      "anyOf": [
        {
          "required": [
            "source_page"
          ]
        },
        {
          "required": [
            "source_sha256",
            "page_idx"
          ]
        }
      ]
    }
  }
}
