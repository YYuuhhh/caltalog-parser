# Set this to a disk on the large server. No weights are downloaded at startup.
MODEL_STORAGE_DIR=./models
# For the 471 GB model, use a disk with at least 500 GB free.
# Bind to the server's private LAN IP to connect the workbench from another host.
BIND_ADDRESS=127.0.0.1
SERVER_PORT=11434
MODEL_KEEP_ALIVE=60s
